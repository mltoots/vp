<!DOCTYPE html>
<html lang="et">
<head>
    <meta charset="utf-8">
    <title>Seose lisamine</title>
</head>
<body>
	<img src="../pic/veebiprogrammeerimine_2026_ID.png" alt="bänner">
    <h1>Uue seose lisamine</h1>

    <form action="/eestifilm/seosed_lisa" method="POST">

        <label for="personInput">Vali inimene:</label>
        <select id="personInput" name="personInput" required>
            <option value="" selected disabled>Vali inimene</option>
            <% personList.forEach(person => { %>
                <option value="<%= person.id %>">
                    <%= person.first_name %> <%= person.last_name %>
                </option>
            <% }); %>
        </select>

        <br><br>

        <label for="movieInput">Vali film:</label>
        <select id="movieInput" name="movieInput" required>
            <option value="" selected disabled>Vali film</option>
            <% movieList.forEach(movie => { %>
                <option value="<%= movie.id %>">
                    <%= movie.title %>
                </option>
            <% }); %>
        </select>

        <br><br>

        <label for="professionInput">Vali amet:</label>
        <select id="professionInput" name="professionInput" required>
            <option value="" selected disabled>Vali amet</option>
            <% professionList.forEach(profession => { %>
                <option value="<%= profession.id %>">
                    <%= profession.title %>
                </option>
            <% }); %>
        </select>

        <br><br>

        <label for="characterInput">Tegelaskuju nimi (näitleja puhul):</label>
        <input type="text" id="characterInput" name="characterInput">

        <br><br>

        <input type="submit" value="Lisa seos">

    </form>
	<hr>
	<ul>
		<li><a href="/eestifilm">Tagasi filmide avalehele</a></p>
		<li><a href="/eestifilm">Tagasi Eesti filmi avalehele</a></li>
	</ul>
</body>
</html>