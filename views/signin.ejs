<!DOCTYPE html>
<html lang="et">
<head>
	<meta charset="utf-8">
	<title>Mia Liisa Toots, veevbiprogrammeerimine</title>
</head>
<body>
<img src="../pic/veebiprogrammeerimine_2026_ID.png" alt="bänner">
	<h1>Logi sisse oma kasutajakontole</h1>
	<hr>
	<form method="POST">
	<label for="emailInput">E-mail (kasutajatunnuseks)</label>
	<input type="email" id="emailInput" name="emailInput" placeholder="Sinu e-mail ...." required>
	<br>
	<label for="passwordInput">Salasõna </label>
	<input type="password" id="passwordInput" name="passwordInput" required>
	<br>
	<input type="submit" id="userLogin" name="userLogin" value="Logi sisse">
  </form>
  <p><%= notice %></p>
	<hr>
	<ul>
		<li><a href="/">Tagasi avalehele</a></li>
	</ul>
</body>
</html>